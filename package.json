{
  "name": "poker-sng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build --mode web",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "npm run build && mkdir -p release && cp dist/index.html \"release/德州扑克SNG.html\" && echo \"单机版: release/德州扑克SNG.html\"",
    "calibrate": "tsx scripts/calibrate.ts",
    "deploy": "scripts/deploy.sh",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
